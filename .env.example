# Copy to .env and fill local values. Never commit real secrets.
POSTGRES_DB=skysentinel
POSTGRES_USER=skysentinel
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Infobip 2FA SMS OTP delivery.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=https://6z2nxr.api.infobip.com
INFOBIP_2FA_APPLICATION_ID=
INFOBIP_2FA_MESSAGE_ID=

# OTP configuration.
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_RESENDS=3
OTP_MAX_ATTEMPTS=5
