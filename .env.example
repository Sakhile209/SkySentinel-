# Copy to .env and set a randomly generated password before starting.
POSTGRES_DB=skysentinel
POSTGRES_USER=skysentinel
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# OTP delivery. Set SMTP_* to send verification codes by email.
# For Gmail, use an app password, not your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
NOTIFICATION_EMAIL_FROM=

# Optional SMS provider webhook. The backend posts {"to","message"} to this URL.
SMS_WEBHOOK_URL=
